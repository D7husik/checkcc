# Test stand (Docker Compose, the machine with the `test-env` runner). Sourced by
# scripts/common.sh. No secrets here: they live in $APP_DIR/.lab_env and .deploy.env.
APP_DIR="${APP_DIR:-$HOME/checkcc-test}"
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-checkcc-test}"
APP_PORT=8001
MYSQL_HOST_PORT=3308
BACKUP_KEEP=7
HEALTH_TIMEOUT=90
