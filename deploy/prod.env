# Prod (no Docker: a systemd service, the machine with the `prod-env` runner). Sourced by
# scripts/common.sh. No secrets here: they live in $APP_DIR/.lab_env, .my.cnf, .deploy.env.
APP_DIR="${APP_DIR:-$HOME/checkcc-prod}"
SERVICE_NAME=checkcc.service
SERVICE_MANAGER=user   # user: systemctl --user; system: sudo systemctl (deploy/sudoers.example)
APP_HOST=127.0.0.1
APP_PORT=8002
DB_NAME=checkcc
KEEP_RELEASES=5
BACKUP_KEEP=14
HEALTH_TIMEOUT=90
